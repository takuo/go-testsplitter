#!/bin/bash

set -euo pipefail

CWD="$(pwd)"
export JSON_DIR={{shquote .JSONDir}}
export REPORT_DIR="${CWD}/test-reports"
mkdir -p "$JSON_DIR" "$REPORT_DIR"

export BINARIES_DIR={{shquote .BinariesDir}}

# run_test INDEX PACKAGE_DIR BINARY TEST_PATTERN
run_test() {
  local count="$1" pkg="$2" bin="${BINARIES_DIR}/$3" pattern="$4"
  local json="${JSON_DIR}/test-{{.NodeIndex}}-${count}.jsonl"
  local report="${REPORT_DIR}/junit-{{.NodeIndex}}-${count}.xml"
  local flags=({{range .TestFlags}}{{shquote .}} {{end}})
  # Use test2json built by testsplitter if available, so that the Go toolchain is not required
  local test2json=(go tool test2json)
  if [[ -x "${BINARIES_DIR}/test2json" ]]; then
    test2json=("${BINARIES_DIR}/test2json")
  fi

  echo "[${count}] ${pkg}: -test.run ${pattern}"
  cd "$pkg" && gotestsum -f standard-verbose \
    --jsonfile "$json" \
    --packages "$pkg" \
    --rerun-fails \
    --junitfile "$report" \
    --junitfile-testsuite-name relative \
    --junitfile-testcase-classname relative \
    --raw-command -- "${test2json[@]}" -t -p "$pkg" "$bin" "${flags[@]}" -test.v=test2json -test.run "$pattern"
}
export -f run_test

# INDEX PACKAGE_DIR BINARY TEST_PATTERN
TESTS=(
{{- range .TestLines}}
  {{.Index}} {{shquote .Package}} {{shquote .Binary}} {{shquote .TestPattern}}
{{- end}}
)

status=0
if (( ${#TESTS[@]} > 0 )); then
  printf '%s\0' "${TESTS[@]}" | xargs -0 -n 4 -P {{.Concurrency}} bash -c 'run_test "$@"' _ || status=$?
fi

# Merge JSON results even if some tests failed
shopt -s nullglob
parts=("${JSON_DIR}"/test-{{.NodeIndex}}-*.jsonl)
if (( ${#parts[@]} > 0 )); then
  cat "${parts[@]}" > "${JSON_DIR}/test-{{.NodeIndex}}.jsonl"
  rm -f "${parts[@]}"
fi

exit "$status"
