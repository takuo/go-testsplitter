#!/bin/bash

set -euo pipefail

LINES=$(cat <<'EOF'
example/pkg2 '^(TestReverseEmpty|TestToUpper)$'
example/pkg3 '^(TestAbsPositive|TestMax|TestAbs|TestMin)$'
example/pkg1 '^(TestMultiply)$'
EOF
)

FLAGS="-test.timeout=20m -test.v"
CWD="$(pwd)"
count=0
commands=()

export PATH="@TESTDATA@/test-bin:$PATH"

while IFS= read -r line; do
  if [ -z "$line" ]; then
    continue
  fi
  count=$((count + 1))
  report="${CWD}/test-reports/junit-1-${count}.xml"
  json="@TESTDATA@/test-json/test-1-${count}.jsonl"
  pkg="${line%% *}"
  bin="${pkg//\//.}.test"
  runs="${line#$pkg }"

  CMD="cd ${pkg} && gotestsum -f standard-verbose --jsonfile ${json} --packages ${pkg} --rerun-fails --junitfile ${report} --junitfile-testsuite-name relative --junitfile-testcase-classname relative --raw-command -- go tool test2json -t -p ${pkg} ${bin} ${FLAGS} -test.v=test2json -test.run ${runs}"
  echo "$CMD"
  commands+=("$CMD")
done <<< "$LINES"

printf "\"%s\"\n" "${commands[@]}" | xargs -I {} -P 4 bash -c '{}'

cat @TESTDATA@/test-json/test-1-*.jsonl > @TESTDATA@/test-json/test-1.jsonl || true
rm @TESTDATA@/test-json/test-1-*.jsonl || true