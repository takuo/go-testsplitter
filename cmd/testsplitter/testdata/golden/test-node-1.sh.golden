#!/bin/bash

set -euo pipefail

CWD="$(pwd)"
export JSON_DIR='@TESTDATA@/test-json'
export REPORT_DIR="${CWD}/test-reports"
mkdir -p "$JSON_DIR" "$REPORT_DIR"

export BINARIES_DIR='@TESTDATA@/test-bin'

# run_test INDEX PACKAGE_DIR BINARY TEST_PATTERN
run_test() {
  local count="$1" pkg="$2" bin="${BINARIES_DIR}/$3" pattern="$4"
  local json="${JSON_DIR}/test-1-${count}.jsonl"
  local report="${REPORT_DIR}/junit-1-${count}.xml"
  local flags=('-test.timeout=20m' '-test.v' )
  # Use test2json built by testsplitter if available, so that the Go toolchain is not required
  local test2json=(go tool test2json)
  if [[ -x "${BINARIES_DIR}/test2json" ]]; then
    test2json=("${BINARIES_DIR}/test2json")
  fi

  echo "[${count}] ${pkg}: -test.run ${pattern}"
  cd "$pkg" && gotestsum -f standard-verbose \
    --jsonfile "$json" \
    --packages "$pkg" \
    --rerun-fails \
    --junitfile "$report" \
    --junitfile-testsuite-name relative \
    --junitfile-testcase-classname relative \
    --raw-command -- "${test2json[@]}" -t -p "$pkg" "$bin" "${flags[@]}" -test.v=test2json -test.run "$pattern"
}
export -f run_test

# INDEX PACKAGE_DIR BINARY TEST_PATTERN
TESTS=(
  1 'example/pkg1' 'example.pkg1.test' '^(TestAdd|TestMultiply|TestMultiplyZero)$'
  2 'example/pkg2' 'example.pkg2.test' '^(TestReverse|TestReverseEmpty)$'
  3 'example/pkg3' 'example.pkg3.test' '^(TestAbsPositive|TestMin)$'
)

status=0
if (( ${#TESTS[@]} > 0 )); then
  printf '%s\0' "${TESTS[@]}" | xargs -0 -n 4 -P 4 bash -c 'run_test "$@"' _ || status=$?
fi

# Merge JSON results even if some tests failed
shopt -s nullglob
parts=("${JSON_DIR}"/test-1-*.jsonl)
if (( ${#parts[@]} > 0 )); then
  cat "${parts[@]}" > "${JSON_DIR}/test-1.jsonl"
  rm -f "${parts[@]}"
fi

exit "$status"
