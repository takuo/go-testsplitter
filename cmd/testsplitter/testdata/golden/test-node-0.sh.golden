#!/bin/bash

set -euo pipefail

CWD="$(pwd)"
export JSON_DIR='@TESTDATA@/test-json'
export REPORT_DIR="${CWD}/test-reports"
mkdir -p "$JSON_DIR" "$REPORT_DIR"

export PATH='@TESTDATA@/test-bin':"$PATH"

# run_test INDEX PACKAGE_DIR TEST_PATTERN
run_test() {
  local count="$1" pkg="$2" pattern="$3"
  local bin="${pkg//\//.}.test"
  local json="${JSON_DIR}/test-0-${count}.jsonl"
  local report="${REPORT_DIR}/junit-0-${count}.xml"
  local flags=('-test.timeout=20m' '-test.v' )

  echo "[${count}] ${pkg}: -test.run ${pattern}"
  cd "$pkg" && gotestsum -f standard-verbose \
    --jsonfile "$json" \
    --packages "$pkg" \
    --rerun-fails \
    --junitfile "$report" \
    --junitfile-testsuite-name relative \
    --junitfile-testcase-classname relative \
    --raw-command -- go tool test2json -t -p "$pkg" "$bin" "${flags[@]}" -test.v=test2json -test.run "$pattern"
}
export -f run_test

# INDEX PACKAGE_DIR TEST_PATTERN
TESTS=(
  1 'example/pkg1' '^(TestAddNegative)$'
  2 'example/pkg2' '^(TestToUpper)$'
  3 'example/pkg3' '^(TestAbs|TestMax|TestMaxEqual)$'
)

status=0
if (( ${#TESTS[@]} > 0 )); then
  printf '%s\0' "${TESTS[@]}" | xargs -0 -n 3 -P 4 bash -c 'run_test "$@"' _ || status=$?
fi

# Merge JSON results even if some tests failed
shopt -s nullglob
parts=("${JSON_DIR}"/test-0-*.jsonl)
if (( ${#parts[@]} > 0 )); then
  cat "${parts[@]}" > "${JSON_DIR}/test-0.jsonl"
  rm -f "${parts[@]}"
fi

exit "$status"
